PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=usof

# Initial administrator; replace locally. Never commit a real password.
ADMIN_LOGIN=initial-admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Initial Administrator
ADMIN_PASSWORD=
# Set true ONLY after independently verifying ownership of ADMIN_EMAIL
# (for example, a one-time code sent to that mailbox and returned to you).
# The bootstrap command does not send email or prove mailbox ownership.
ADMIN_EMAIL_VERIFIED=false

# Email service (optional; defaults to test mock/JSON transport if not set)
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@usof.local
